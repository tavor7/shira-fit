{
  "expo": {
    "name": "Shira Fit",
    "slug": "shira-fit",
    "version": "1.0.0",
    "scheme": "shirafit",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-status-bar",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shirafit.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.shirafit.app"
    },
    "extra": {
      "deepLinkExamples": "Scheme: shirafit — e.g. shirafit:///(app)/athlete/session/<sessionId> or https://<your-domain>/(app)/athlete/sessions with expo-router + associated domains / intent filters.",
      "router": {},
      "eas": {
        "projectId": "962ac0d2-8e62-4de2-896a-67ce33b66524"
      }
    },
    "owner": "amittavor"
  }
}
