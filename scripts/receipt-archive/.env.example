# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit real credentials.
# Do not paste these values into chat with an assistant; edit this file directly.

# Cloudflare account id (not secret, but keep it here for convenience).
# Find it in the Cloudflare dashboard URL or the R2 bucket's "S3 API" settings page.
CF_ACCOUNT_ID=

# R2 bucket (EU jurisdiction) — endpoint is derived from CF_ACCOUNT_ID, do not hardcode a guessed URL.
R2_ARCHIVE_BUCKET=shirafit-receipt-archive

# Writer credential: Object Read & Write, scoped to shirafit-receipt-archive only.
R2_ARCHIVE_WRITER_ACCESS_KEY_ID=
R2_ARCHIVE_WRITER_SECRET_ACCESS_KEY=

# Reader credential: Object Read only, scoped to shirafit-receipt-archive only.
R2_ARCHIVE_READER_ACCESS_KEY_ID=
R2_ARCHIVE_READER_SECRET_ACCESS_KEY=

# Supabase — read-only usage in this tooling (Storage listing + object download only).
# Reuses the existing service-role key already stored at supabase/.secrets/.env (SB_URL / SB_SERVICE_ROLE_KEY).
# Leave these blank to auto-load from ../../supabase/.secrets/.env instead.
SB_URL=
SB_SERVICE_ROLE_KEY=
