# Mobile (Expo) — copy to mobile/.env or use app.config.js extra
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Used for Supabase auth emails (confirm + reset). Must be a real reachable origin (NOT localhost).
# Example: https://app.shirafit.com
EXPO_PUBLIC_AUTH_REDIRECT_ORIGIN=

# Supabase Edge Functions (set via `supabase secrets set` or Dashboard → Functions → Secrets)
# SUPABASE_SERVICE_ROLE_KEY — auto in hosted functions
# CRON_SECRET — random string; Authorization: Bearer <CRON_SECRET> for cron-triggered functions
# RESEND_API_KEY — email delivery for receipts/documents (send-document-email)
# WHATSAPP_ACCESS_TOKEN, WHATSAPP_PHONE_NUMBER_ID — WhatsApp template messages (dispatch-notifications)
# R2_ACCOUNT_ID — Cloudflare account id for the EU-jurisdiction endpoint (archive-document-pdf)
# R2_ARCHIVE_BUCKET — defaults to shirafit-receipt-archive if unset (archive-document-pdf)
# R2_WRITER_ACCESS_KEY_ID, R2_WRITER_SECRET_ACCESS_KEY — Object Read & Write, scoped to the archive bucket only (archive-document-pdf, upload path)
# R2_READER_ACCESS_KEY_ID, R2_READER_SECRET_ACCESS_KEY — Object Read only, scoped to the archive bucket only (archive-document-pdf, verification path)
#   Same credentials already provisioned for scripts/receipt-archive/ — set via `supabase secrets set`, never committed, never shipped to mobile/web.
